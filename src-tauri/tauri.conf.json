{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenshot Memory",
  "version": "0.1.1",
  "identifier": "com.athernull.screenshotmemory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screenshot Memory",
        "width": 1360,
        "height": 880,
        "minWidth": 760,
        "minHeight": 680,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost thumb: http://thumb.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Akagg07",
    "copyright": "Copyright © 2026 Akagg07",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
